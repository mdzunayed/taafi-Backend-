# Copy to .env (docker-compose ignores .env.example, it reads .env)
PORT=4000
MONGO_URI=mongodb://mongo:27017/taafi
UPLOAD_DIR=/app/uploads
# Public origin of THIS service. Used to build absolute /uploads URLs handed
# to clients. MUST be set in any deployment: unset, uploads resolve to
# localhost and no phone or remote browser can load them. No trailing slash.
PUBLIC_BASE_URL=http://localhost:4000

# ── Image storage (middleware/cloudinary.js) ──────────────────────────────
# Render's filesystem is EPHEMERAL — anything written to ./uploads is wiped
# on the next sleep or redeploy, which is why uploaded images "go black".
# With these set, images go to Cloudinary instead and the stored https URL
# stays valid forever.
#
# The server REFUSES TO BOOT when NODE_ENV is anything other than
# development/test and none of these are set (see the storage preflight in
# src/server.js) — a silent fall back to ephemeral disk in production is
# always data loss.
#
# Either form works. Copy the "API Environment variable" from your
# Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or set the three separately:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Security hardening (middleware/security.js) ───────────────────────────
# Comma-separated allow-list of browser Origins permitted to call the API
# (the web admin console + any hosted web build). Native mobile apps send
# no Origin header and are always allowed. Leave unset in local dev to fall
# back to a permissive "*" (native + localhost tooling). NEVER leave unset
# in production: an empty list does not fail closed, it reflects EVERY origin
# with credentials enabled. The server warns loudly at boot if you do.
# CORS_ALLOWED_ORIGINS=https://admin.taafi.app,https://taafi.app
#
# Accept http(s)://localhost | 127.0.0.1 | [::1] on ANY port, on top of the
# allow-list above. `flutter run -d chrome` picks a new random port each launch,
# so a local web build can never be named in an exact-match list — without this
# the preflight fails and Dio on web reports it as a bare "XMLHttpRequest
# error" with no status. Always on when NODE_ENV is development/test; set to 1
# to also allow it on a deployed instance while you develop against it, and
# unset it when you are done.
# CORS_ALLOW_LOCALHOST=0
#
# Trust the X-Forwarded-For header from exactly N upstream proxies so the
# rate limiter keys on the real client IP instead of the load balancer's.
# DEFAULT IS 1 — correct behind a single nginx / Render / Fly proxy, which is
# how this API is deployed. Set to 0 ONLY when nothing proxies the app (bare
# VPS / direct docker port), where trusting X-Forwarded-For would let a client
# spoof its own IP and evade the auth limiter.
TRUST_PROXY_HOPS=1
# Global limiter cap per IP per 15-minute window. Defaults to 1000; raise it
# from the host's dashboard if legitimate clients start seeing 429s.
# RATE_LIMIT_MAX=1000
# Set to "1" to disable all rate limiting (local load testing only).
RATE_LIMIT_DISABLED=0

# ── Redis (services/cacheService.js + queues/notificationQueue.js) ────────
# Shared by the read-cache layer and the BullMQ background worker. When
# UNSET, both subsystems degrade gracefully: the cache becomes a pass-through
# (every request hits Mongo) and queued jobs run inline in-process. The API
# stays fully functional without Redis — you just lose the perf/HA benefits.
# REDIS_URL=redis://localhost:6379
#
# Namespaced key prefix so multiple Taafi environments can share one Redis.
REDIS_PREFIX=taafi
# Read-cache TTL in seconds for public catalog endpoints (services/banners).
CACHE_TTL_SECONDS=300
# Run the BullMQ worker inside the API process (default). Set to 0 and run
# `node src/queues/worker.js` as a separate dyno to scale workers horizontally.
QUEUE_INLINE_WORKER=1

# Fixed platform fee (BDT) a patient pays to unlock a newly issued
# prescription (see utils/money.js). Defaults to 100 when unset.
PRESCRIPTION_UNLOCK_FEE=100

# Optional: point puppeteer (prescription PDF renderer) at a system
# Chromium instead of the bundled one. Pair with
# `PUPPETEER_SKIP_DOWNLOAD=1 npm install` on hosts where the ~300MB
# bundled-Chromium download is unwanted or blocked.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Masked calling (services/telephonyService.js) ─────────────────────────
# When ALL THREE are set the telephony service switches from the built-in
# `simulated` driver to live Twilio dual-leg dialing (patient ↔ provider via
# a proxy number, neither side sees the other's real mobile). Leave unset for
# local dev / demos — the simulated driver returns a "connecting" status so
# the full UX works without a paid account. Requires `npm i twilio` before
# the live driver can dial.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PROXY_NUMBER=+8809600xxxxx
# TWILIO_STATUS_CALLBACK_URL=
